# Copy to server/.env and fill in. server/.env is gitignored; never commit it.
# In GitHub Codespaces prefer a Codespaces secret named RUNWARE_API_KEY instead (env vars win over this file).
RUNWARE_API_KEY=

# Optional
# AI_PROXY_PORT=8787
# AI_PROXY_HOST=127.0.0.1
# RUNWARE_MOCK=1
# RUNWARE_MOCK_DELAY_MS=3000   (mock only: fake latency to test the loading and cancel UI)
